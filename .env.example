# Copy to .env and adjust. Never commit the real .env.
PORT=8080
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
TALKBURST_INSTANCE_ID=node-1
TALKBURST_FLOOR_GRANT_TTL=PT10S
TALKBURST_FLOOR_MAX_BURST=PT30S
TALKBURST_FLOOR_MAX_QUEUE=16
TALKBURST_SESSION_IDLE_TTL=PT2H
TALKBURST_SESSION_MAX_PARTICIPANTS=64
TALKBURST_ALLOWED_ORIGINS=*
# Shared secret required to join as DISPATCHER or SUPERVISOR (blank disables the check)
TALKBURST_PRIVILEGED_ROLE_KEY=
